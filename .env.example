# Copy this file to .env, replace every placeholder, and do not commit .env.
AGENTSHIELD_ENVIRONMENT=production
AGENTSHIELD_FRONTEND_URL=https://agentshield.example.com
AGENTSHIELD_SCAN_RETENTION_DAYS=30
AGENTSHIELD_UNVERIFIED_ACCOUNT_RETENTION_DAYS=7
AGENTSHIELD_MAX_ACTIVE_SCANS_PER_TENANT=2
AGENTSHIELD_MAX_SCANS_PER_TENANT_PER_DAY=50
AGENTSHIELD_ALLOWED_WEB_HOSTS=agentshield.example.com
# Exact hostnames only. Restrict outbound network access at the firewall as well.
AGENTSHIELD_ALLOWED_TARGET_HOSTS=agent-api.example.com
AGENTSHIELD_JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
AGENTSHIELD_ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
AGENTSHIELD_SMTP_HOST=smtp.example.com
AGENTSHIELD_SMTP_PORT=587
AGENTSHIELD_SMTP_USERNAME=agentshield@example.com
AGENTSHIELD_SMTP_PASSWORD=replace-with-smtp-password
AGENTSHIELD_SMTP_FROM_EMAIL=agentshield@example.com
AGENTSHIELD_SMTP_STARTTLS=true
POSTGRES_PASSWORD=replace-with-a-random-database-password
AGENTSHIELD_HOST=agentshield.example.com
